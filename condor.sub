universe = vanilla

executable              = condor.sh
arguments               = $(Process)
log                     = condor_logs/test.log 
output                  = condor_logs/outfile.$(Cluster).$(Process).out
error                   = condor_logs/errors.$(Cluster).$(Process).err



getenv = True
request_cpus   = 8
request_memory = 16384
request_gpus = 1
requirements = (Target.CUDACapability >= 7.0) || (Target.GPUs_Capability >= 7.0) || regexp("V100|A100|H100", Target.CUDADeviceName)
rank         = Target.CUDACapability

queue

