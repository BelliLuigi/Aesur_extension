universe        = vanilla
executable      = train.sh

# Default parameters (override on CLI via: key=value)
script          = train_coorbital_ae.py
title           = run_$(Cluster)
extra_args      =

arguments       = $(script) --title $(title) $(extra_args)

log             = condor_logs/$(title)_$(Cluster).log
output          = condor_logs/$(title)_$(Cluster).$(Process).out
error           = condor_logs/$(title)_$(Cluster).$(Process).err

getenv          = True
request_cpus    = 8
request_memory  = 16384
request_gpus    = 1
requirements    = (Target.CUDACapability >= 7.0) || (Target.GPUs_Capability >= 7.0) || regexp("V100|A100|H100", Target.CUDADeviceName)
rank            = Target.CUDACapability

queue
