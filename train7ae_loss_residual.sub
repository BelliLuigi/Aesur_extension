universe = vanilla

executable              = train7ae_loss_residual.sh
log                     = condor_logs/train7ae_loss_residual.log
output                  = condor_logs/train7ae_loss_residual.$(Cluster).$(Process).out
error                   = condor_logs/train7ae_loss_residual.$(Cluster).$(Process).err

getenv = True
request_cpus   = 8
request_memory = 16384
